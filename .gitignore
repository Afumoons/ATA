*.py[cod]
*.pyo
*.pyd
*.so
.env
.venv
venv/
env/

# --- Build / dist / eggs ---
build/
dist/
.eggs/
*.egg-info/
*.egg

# --- Logs & temp ---
logs/
*.log
tmp/
temp/
.cache/
