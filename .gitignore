# ============================================================
# .gitignore — autonomous_trading_ai
# ============================================================

# --- OS & editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.code-workspace

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.venv/
venv/
env/
.env

# --- Build / dist ---
build/
dist/
.eggs/
*.egg-info/
*.egg

# --- Logs & temp ---
*.log
logs/
tmp/
temp/
.cache/
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================================
# Autonomous Trading AI — specific ignores
# ============================================================

# --- MT5 / broker data (large, regenerated each run) ---
data/raw/
data/features/

# Keep news events (manually curated, lightweight)
!data/raw/news_events.parquet
!data/raw/news_events.csv

# --- Backtest outputs (large, reproducible) ---
backtests/results/

# --- Generated strategy files (hundreds of JSONs, regenerated) ---
strategies/generated/

# --- Live state files (machine-specific, changes every 5 min) ---
execution/closed_trades_state.json
execution/equity_history.json
execution/live_state.json
execution/open_trades.json
execution/strategy_live_stats.json
execution/trades.log
execution/ticket_strategy_map.json
execution/unmatched_closed_deals.json

# --- ChromaDB vector store (large, rebuilt from research cycles) ---
chroma_data/

# --- Pool state: KEEP THIS in git ---
# pool_state.json is valuable — tracks which strategies are active
# Uncomment below ONLY if pool grows too large (>5MB)
# strategies/pool_state.json

# --- Credentials & private config ---
*.env
*.env.*
.envrc
secrets/
keys/
config/local_*.yml
config/local_*.json
config/private/
*.pem
*.key

# --- Jupyter / experiments ---
*.ipynb

# --- Tool caches ---
.mypy_cache/
.pytest_cache/
coverage/
htmlcov/
.tox/
pytest_debug.log

# --- Node (if dashboard added later) ---
node_modules/
npm-debug.log*
yarn.lock
pnpm-lock.yaml