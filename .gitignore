!data_samples/

# --- Credentials / config private ---
*.env
*.env.*
.envrc
secrets/
keys/
config/local_*.yml
config/local_*.json
config/private/
*.pem
*.key

# --- Jupyter / experiments ---
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Cache dari tools ---
.mypy_cache/
.pytest_cache/
coverage/
htmlcov/
.tox/
pytest_debug.log

# --- Node (kalau ada dashboard / UI pendukung) ---
